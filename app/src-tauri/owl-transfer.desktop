[Desktop Entry]
Type=Application
# The product name as a person reads it. The package, the binary and the icon
# files stay owl-transfer so an installed copy upgrades in place.
Name=OwlTransfer
{{#if comment}}
Comment={{comment}}
{{/if}}
Categories={{categories}}
Icon={{icon}}
Terminal=false
StartupNotify=true
# The window announces itself to the desktop under the binary's name, because
# Tauri sets no GTK application id and GTK falls back to the program name.
# GNOME pairs a window with a launcher by that class, and this file is named
# after the product, not the binary, so the class has to be spelled out here.
# Without it the dock shows the running window under a blank icon beside the
# pinned owl. A test in lib.rs keeps this equal to mainBinaryName.
StartupWMClass=owl-transfer
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
# On NVIDIA, WebKitGTK without __NV_DISABLE_EXPLICIT_SYNC=1 hands back an empty
# frame: the window comes up blank white, with no error anywhere. If a machine
# is still blank with it set, try WEBKIT_DISABLE_DMABUF_RENDERER=1 as well.
#
# The one that actually counts is lib.rs, which sets the same variable in
# process before anything creates a webview: that covers `tauri dev`, running
# the binary directly, and the AppImage, whose AppRun never reads this file.
# This line covers a launcher that execs Exec= and nothing else.
Exec=env __NV_DISABLE_EXPLICIT_SYNC=1 {{exec}} {{exec_arg}}
