<?xml version="1.0" encoding="utf-8"?>
<!--
  The one colour Android draws for itself.

  The activity is laid out edge to edge and the web layer is padded in by the
  system bar insets, so the strips behind the status bar and the gesture handle
  are the window background rather than anything the interface paints. This is
  the interface's own paper colour from app/src/tokens.css, so the seam does not
  show. values-night carries the dark theme's ground.
-->
<resources>
    <color name="owl_ground">#F8F7F4</color>
</resources>
