<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11, which does not read data_extraction_rules.xml. Same rule: nothing
  this app stores is backed up. See that file for why.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
