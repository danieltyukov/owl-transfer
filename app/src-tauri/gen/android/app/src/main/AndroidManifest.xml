<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android drops broadcast and multicast at the Wi-Fi driver unless the
         app holds a MulticastLock, and discovery is a broadcast. MainActivity
         takes the lock; this is permission to take it. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- The sync folder is /storage/emulated/0/OwlTransfer, in shared storage,
         so that every file manager and gallery on the phone can see what was
         synced. Reaching it needs all files access, the same permission every
         file manager and Syncthing hold. No runtime dialog grants it: the
         person turns it on from a system screen, which OwlPlugin opens.

         This is the only storage permission declared, and it is the reason
         minSdk is 30. Before Android 11 there was no all files access, so the
         app would have had to request WRITE_EXTERNAL_STORAGE at runtime and
         answer a different question about whether the folder is reachable. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Nothing this app stores may leave the device.

         The data directory holds the engine's private key, and its SHA-256
         fingerprint is the device id that every paired peer pins. A backup
         restored onto a second phone would clone that identity and put two
         devices on the network presenting the same fingerprint, which is the
         one thing the trust model cannot survive.

         allowBackup="false" is not enough on its own from Android 12: it stops
         cloud backup but not device to device transfer, so the rules file
         excludes both. fullBackupContent covers Android 11, where the rules
         file is not read. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.owl_transfer"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Share a photo, a document, anything, to Owl Transfer and it is
                 copied into the sync folder and is on the desktop a moment
                 later. The activity is singleTask, so a share while the app is
                 already open arrives at onNewIntent rather than onCreate. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
